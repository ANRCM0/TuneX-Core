{
  "name": "tunex-vnext",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.14.1 <25", "npm": ">=11 <12" },
  "packageManager": "npm@11.11.0",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test packages/core/test/*.test.ts packages/contracts/test/*.test.ts apps/control/test/*.test.ts",
    "test:go": "node scripts/run-go.mjs test ./...",
    "build:go": "node scripts/run-go.mjs build ./...",
    "check": "npm run typecheck && npm test && npm run test:go && npm run build:go && npm run contracts:check && node scripts/check-boundaries.mjs && node scripts/verify-offline-plan.mjs",
    "contracts:generate": "node scripts/generate-go-contracts.mjs",
    "contracts:check": "node scripts/generate-go-contracts.mjs --check && node scripts/build-conformance-fixtures.mjs --check",
    "plan": "node apps/control/src/cli.ts",
    "control": "node apps/control/src/main.ts",
    "control:bootstrap": "node apps/control/src/bootstrap.ts",
    "control:cli": "node apps/control/src/client.ts",
    "test:phase1": "node scripts/phase1/acceptance.ts",
    "test:phase2": "node scripts/phase2/acceptance.ts",
    "test:security": "node scripts/phase2/security.ts",
    "test:faults": "node scripts/phase2/faults.ts",
    "test:linux-agent": "node scripts/phase2/linux-agent.ts",
    "test:relay-agent": "node scripts/phase2/linux-agent.ts --relay",
    "test:access": "node scripts/phase2/access.ts",
    "ops": "node scripts/ops/cli.ts",
    "test:recovery": "node scripts/phase2/recovery.ts",
    "test:capacity": "node scripts/phase2/capacity.ts",
    "test:transport": "node scripts/phase2/transport.ts"
  },
  "devDependencies": { "@types/node": "24.10.1", "typescript": "5.9.3" }
}
