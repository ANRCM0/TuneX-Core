{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tunex:probe:delivery:1",
  "title": "Probe v1 bounded discovery and point-in-time consumed observations",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "token": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "counter": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "minLength": 24,
      "maxLength": 24,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "Binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodeId": {
          "$ref": "#/$defs/id"
        },
        "bootId": {
          "$ref": "#/$defs/id"
        },
        "sessionEpoch": {
          "$ref": "#/$defs/counter"
        },
        "snapshotGeneration": {
          "$ref": "#/$defs/counter"
        },
        "assignmentId": {
          "$ref": "#/$defs/id"
        },
        "forwardId": {
          "$ref": "#/$defs/id"
        },
        "forwardRevision": {
          "$ref": "#/$defs/counter"
        },
        "deploymentGeneration": {
          "$ref": "#/$defs/counter"
        },
        "bindingFence": {
          "$ref": "#/$defs/counter"
        },
        "configDigest": {
          "type": "string",
          "minLength": 71,
          "maxLength": 71,
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "egressPolicyRevision": {
          "$ref": "#/$defs/counter"
        }
      },
      "required": [
        "nodeId",
        "bootId",
        "sessionEpoch",
        "snapshotGeneration",
        "assignmentId",
        "forwardId",
        "forwardRevision",
        "deploymentGeneration",
        "bindingFence",
        "configDigest",
        "egressPolicyRevision"
      ]
    },
    "Offer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "permitId": {
          "$ref": "#/$defs/id"
        },
        "binding": {
          "$ref": "#/$defs/Binding"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 2000
        },
        "issuedAt": {
          "$ref": "#/$defs/time"
        },
        "expiresAt": {
          "$ref": "#/$defs/time"
        }
      },
      "required": [
        "permitId",
        "binding",
        "timeoutMs",
        "issuedAt",
        "expiresAt"
      ]
    },
    "PollRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocolVersion": {
          "const": 3
        },
        "probeVersion": {
          "const": 1
        },
        "nodeId": {
          "$ref": "#/$defs/id"
        },
        "bootId": {
          "$ref": "#/$defs/id"
        },
        "sessionEpoch": {
          "$ref": "#/$defs/counter"
        },
        "instanceId": {
          "$ref": "#/$defs/token"
        },
        "instanceGeneration": {
          "$ref": "#/$defs/counter"
        },
        "requestId": {
          "$ref": "#/$defs/token"
        },
        "kind": {
          "const": "probe-poll"
        }
      },
      "required": [
        "protocolVersion",
        "probeVersion",
        "nodeId",
        "bootId",
        "sessionEpoch",
        "instanceId",
        "instanceGeneration",
        "requestId",
        "kind"
      ]
    },
    "PollResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocolVersion": {
          "const": 3
        },
        "probeVersion": {
          "const": 1
        },
        "nodeId": {
          "$ref": "#/$defs/id"
        },
        "bootId": {
          "$ref": "#/$defs/id"
        },
        "sessionEpoch": {
          "$ref": "#/$defs/counter"
        },
        "instanceId": {
          "$ref": "#/$defs/token"
        },
        "instanceGeneration": {
          "$ref": "#/$defs/counter"
        },
        "requestId": {
          "$ref": "#/$defs/token"
        },
        "kind": {
          "const": "probe-poll-ack"
        },
        "observedAt": {
          "$ref": "#/$defs/time"
        },
        "serverTime": {
          "$ref": "#/$defs/time"
        },
        "executionEnabled": {
          "const": false
        },
        "offer": {
          "anyOf": [
            {
              "$ref": "#/$defs/Offer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "protocolVersion",
        "probeVersion",
        "nodeId",
        "bootId",
        "sessionEpoch",
        "instanceId",
        "instanceGeneration",
        "requestId",
        "kind",
        "observedAt",
        "serverTime",
        "executionEnabled",
        "offer"
      ]
    },
    "StatusRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocolVersion": {
          "const": 3
        },
        "probeVersion": {
          "const": 1
        },
        "nodeId": {
          "$ref": "#/$defs/id"
        },
        "bootId": {
          "$ref": "#/$defs/id"
        },
        "sessionEpoch": {
          "$ref": "#/$defs/counter"
        },
        "instanceId": {
          "$ref": "#/$defs/token"
        },
        "instanceGeneration": {
          "$ref": "#/$defs/counter"
        },
        "requestId": {
          "$ref": "#/$defs/token"
        },
        "kind": {
          "const": "probe-status"
        },
        "permitId": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "protocolVersion",
        "probeVersion",
        "nodeId",
        "bootId",
        "sessionEpoch",
        "instanceId",
        "instanceGeneration",
        "requestId",
        "kind",
        "permitId"
      ]
    },
    "StatusResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocolVersion": {
          "const": 3
        },
        "probeVersion": {
          "const": 1
        },
        "nodeId": {
          "$ref": "#/$defs/id"
        },
        "bootId": {
          "$ref": "#/$defs/id"
        },
        "sessionEpoch": {
          "$ref": "#/$defs/counter"
        },
        "instanceId": {
          "$ref": "#/$defs/token"
        },
        "instanceGeneration": {
          "$ref": "#/$defs/counter"
        },
        "requestId": {
          "$ref": "#/$defs/token"
        },
        "kind": {
          "const": "probe-status-ack"
        },
        "permitId": {
          "$ref": "#/$defs/id"
        },
        "binding": {
          "$ref": "#/$defs/Binding"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 2000
        },
        "issuedAt": {
          "$ref": "#/$defs/time"
        },
        "expiresAt": {
          "$ref": "#/$defs/time"
        },
        "consumedAt": {
          "$ref": "#/$defs/time"
        },
        "checkedAt": {
          "$ref": "#/$defs/time"
        },
        "serverTime": {
          "$ref": "#/$defs/time"
        },
        "state": {
          "const": "consumed"
        },
        "executionEnabled": {
          "const": false
        }
      },
      "required": [
        "protocolVersion",
        "probeVersion",
        "nodeId",
        "bootId",
        "sessionEpoch",
        "instanceId",
        "instanceGeneration",
        "requestId",
        "kind",
        "permitId",
        "binding",
        "timeoutMs",
        "issuedAt",
        "expiresAt",
        "consumedAt",
        "checkedAt",
        "serverTime",
        "state",
        "executionEnabled"
      ]
    }
  }
}
