  "semanticCases": [
    {
      "name": "renewal-preserves-execution",
      "snapshots": [
        "direct-snapshot",
        "renewal-same-execution"
      ],
      "expected": "generation increases; driver config and deployment/fence stay identical; no listener/stream restart"
    },
    {
      "name": "alter-target-without-updating-digest",
      "base": "direct-snapshot",
      "expected": "INTEGRITY_FAILURE despite structural validity"
    },
    {
      "name": "old-session-report",
      "base": "report",
      "currentSessionEpoch": 2,
      "expected": "SESSION_SUPERSEDED; cannot advance operation"
    },
    {
      "name": "duplicate-key",
      "raw": "{\"protocolVersion\":2,\"protocolVersion\":1}",
      "expected": "reject before Schema validation"
    }
  ]
}
