{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tunex:probe:instance:1",
  "title": "Probe v1 non-executable instance ownership",
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "instanceId": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$" },
    "counter": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "epoch": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "time": { "type": "string", "format": "date-time", "minLength": 24, "maxLength": 24,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "Request": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "protocolVersion": { "const": 3 }, "probeVersion": { "const": 1 },
        "kind": { "const": "probe-instance" },
        "action": { "enum": ["inspect", "register", "revoke"] },
        "nodeId": { "$ref": "#/$defs/id" }, "bootId": { "$ref": "#/$defs/id" },
        "sessionEpoch": { "$ref": "#/$defs/epoch" }, "instanceId": { "$ref": "#/$defs/instanceId" },
        "expectedGeneration": { "$ref": "#/$defs/counter" }
      },
      "required": ["protocolVersion", "probeVersion", "kind", "action", "nodeId", "bootId", "sessionEpoch", "instanceId", "expectedGeneration"]
    },
    "Response": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "protocolVersion": { "const": 3 }, "probeVersion": { "const": 1 },
        "kind": { "const": "probe-instance-ack" },
        "action": { "enum": ["inspect", "register", "revoke"] },
        "nodeId": { "$ref": "#/$defs/id" }, "bootId": { "$ref": "#/$defs/id" },
        "sessionEpoch": { "$ref": "#/$defs/epoch" }, "instanceId": { "$ref": "#/$defs/instanceId" },
        "expectedGeneration": { "$ref": "#/$defs/counter" }, "generation": { "$ref": "#/$defs/counter" },
        "state": { "enum": ["absent", "registered", "stale", "revoked", "quarantined"] },
        "currentInstanceId": { "anyOf": [{ "$ref": "#/$defs/instanceId" }, { "type": "null" }] },
        "registeredAt": { "anyOf": [{ "$ref": "#/$defs/time" }, { "type": "null" }] },
        "expiresAt": { "anyOf": [{ "$ref": "#/$defs/time" }, { "type": "null" }] },
        "serverTime": { "$ref": "#/$defs/time" }, "executionEnabled": { "const": false }
      },
      "required": ["protocolVersion", "probeVersion", "kind", "action", "nodeId", "bootId", "sessionEpoch", "instanceId", "expectedGeneration",
        "generation", "state", "currentInstanceId", "registeredAt", "expiresAt", "serverTime", "executionEnabled"]
    }
  }
}
