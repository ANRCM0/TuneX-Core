{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:tunex:probe:services:3",
  "title":"Closed service-bound Probe v3 machine messages",
  "$defs":{
    "Id":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "ServiceId":{"type":"string","minLength":1,"maxLength":64,"pattern":"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "Hex":{"type":"string","minLength":64,"maxLength":64,"pattern":"^[a-f0-9]{64}$"},
    "Hash":{"type":"string","minLength":71,"maxLength":71,"pattern":"^sha256:[a-f0-9]{64}$"},
    "Counter":{"type":"integer","minimum":1,"maximum":9007199254740991},
    "Milliseconds":{"type":"integer","minimum":0,"maximum":253402300799999},
    "Time":{"type":"string","format":"date-time","pattern":"Z$"},
    "Machine":{"type":"object","properties":{
      "protocolVersion":{"const":3},"probeVersion":{"const":3},"nodeId":{"$ref":"#/$defs/Id"},"bootId":{"$ref":"#/$defs/Id"},
      "sessionEpoch":{"$ref":"#/$defs/Counter"},"instanceId":{"$ref":"#/$defs/Hex"},"instanceGeneration":{"$ref":"#/$defs/Counter"},"requestId":{"$ref":"#/$defs/Hex"}
    },"required":["protocolVersion","probeVersion","nodeId","bootId","sessionEpoch","instanceId","instanceGeneration","requestId"]},
    "Measurements":{"type":"array","prefixItems":[{"const":"tcp-connect-v1"},{"const":"tcp-ingress-connect-v1"},{"const":"tcp-ingress-tls-v1"}],"items":false,"minItems":3,"maxItems":3},
    "Descriptor":{"type":"object","properties":{
      "measurement":{"enum":["tcp-connect-v1","tcp-ingress-connect-v1","tcp-ingress-tls-v1"]},
      "taskKind":{"enum":["tcp-connect","tcp-ingress-connect","tcp-ingress-tls"]},
      "point":{"enum":["agent-direct-egress","agent-local-direct-ingress"]},
      "capability":{"enum":["probe.tcp-connect.v1","probe.tcp-ingress-connect.v1","probe.tcp-ingress-tls.v1"]}
    },"required":["measurement","taskKind","point","capability"],"oneOf":[
      {"properties":{"measurement":{"const":"tcp-connect-v1"},"taskKind":{"const":"tcp-connect"},"point":{"const":"agent-direct-egress"},"capability":{"const":"probe.tcp-connect.v1"}}},
      {"properties":{"measurement":{"const":"tcp-ingress-connect-v1"},"taskKind":{"const":"tcp-ingress-connect"},"point":{"const":"agent-local-direct-ingress"},"capability":{"const":"probe.tcp-ingress-connect.v1"}}},
      {"properties":{"measurement":{"const":"tcp-ingress-tls-v1"},"taskKind":{"const":"tcp-ingress-tls"},"point":{"const":"agent-local-direct-ingress"},"capability":{"const":"probe.tcp-ingress-tls.v1"}}}
    ]},
    "SelectionFields":{"type":"object","properties":{
      "scopeId":{"$ref":"#/$defs/Id"},"serviceId":{"$ref":"#/$defs/ServiceId"},"revision":{"$ref":"#/$defs/Counter"},
      "configRevision":{"type":"integer","minimum":1,"maximum":64},"configDigest":{"$ref":"#/$defs/Hash"},"contextDigest":{"$ref":"#/$defs/Hash"}
    },"required":["scopeId","serviceId","revision","configRevision","configDigest","contextDigest"]},
    "ServiceSelection":{"type":"object","allOf":[{"$ref":"#/$defs/SelectionFields"}],"unevaluatedProperties":false},
    "ServiceConfig":{"type":"object","additionalProperties":false,"properties":{
      "version":{"const":1},"purpose":{"const":"direct-ingress-tls-handshake"},
      "endpoint":{"type":"object","additionalProperties":false,"properties":{"address":{"type":"string","minLength":2,"maxLength":45},"port":{"type":"integer","minimum":1,"maximum":65535}},"required":["address","port"]},
      "trust":{"type":"object","additionalProperties":false,"properties":{"mode":{"const":"pinned-leaf-v1"},"serverName":{"type":"string","minLength":3,"maxLength":253},"certificateDer":{"type":"string","minLength":4,"maxLength":10924,"pattern":"^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"}},"required":["mode","serverName","certificateDer"]},
      "validFrom":{"$ref":"#/$defs/Milliseconds"},"validUntil":{"$ref":"#/$defs/Milliseconds"}
    },"required":["version","purpose","endpoint","trust","validFrom","validUntil"]},
    "ServiceContext":{"type":"object","allOf":[{"$ref":"#/$defs/SelectionFields"}],"properties":{"config":{"$ref":"#/$defs/ServiceConfig"}},"required":["config"],"unevaluatedProperties":false},
    "NullableSelection":{"oneOf":[{"$ref":"#/$defs/ServiceSelection"},{"type":"null"}]},
    "Binding":{"type":"object","additionalProperties":false,"properties":{
      "nodeId":{"$ref":"#/$defs/Id"},"bootId":{"$ref":"#/$defs/Id"},"sessionEpoch":{"$ref":"#/$defs/Counter"},"snapshotGeneration":{"$ref":"#/$defs/Counter"},
      "assignmentId":{"$ref":"#/$defs/Id"},"forwardId":{"$ref":"#/$defs/Id"},"forwardRevision":{"$ref":"#/$defs/Counter"},"deploymentGeneration":{"$ref":"#/$defs/Counter"},
      "bindingFence":{"$ref":"#/$defs/Counter"},"configDigest":{"$ref":"#/$defs/Hash"},"egressPolicyRevision":{"$ref":"#/$defs/Counter"}
    },"required":["nodeId","bootId","sessionEpoch","snapshotGeneration","assignmentId","forwardId","forwardRevision","deploymentGeneration","bindingFence","configDigest","egressPolicyRevision"]},
    "Permit":{"type":"object","properties":{"permitId":{"$ref":"#/$defs/Id"},"binding":{"$ref":"#/$defs/Binding"},"timeoutMs":{"type":"integer","minimum":100,"maximum":2000},"issuedAt":{"$ref":"#/$defs/Time"},"expiresAt":{"$ref":"#/$defs/Time"}},"required":["permitId","binding","timeoutMs","issuedAt","expiresAt"]},
    "Offer":{"type":"object","allOf":[{"$ref":"#/$defs/Descriptor"},{"$ref":"#/$defs/Permit"}],"properties":{"serviceContext":{"oneOf":[{"$ref":"#/$defs/ServiceContext"},{"type":"null"}]}},"required":["serviceContext"],"unevaluatedProperties":false},
    "QualificationRequest":{"type":"object","allOf":[{"$ref":"#/$defs/Machine"}],"properties":{"kind":{"const":"probe-services-instance"},"action":{"enum":["inspect","register","revoke"]},"measurements":{"$ref":"#/$defs/Measurements"}},"required":["kind","action","measurements"],"unevaluatedProperties":false},
    "QualificationResponse":{"type":"object","allOf":[{"$ref":"#/$defs/Machine"}],"properties":{"kind":{"const":"probe-services-instance-ack"},"action":{"enum":["inspect","register","revoke"]},"measurements":{"$ref":"#/$defs/Measurements"},"qualified":{"type":"boolean"},"qualifiedAt":{"oneOf":[{"$ref":"#/$defs/Time"},{"type":"null"}]},"expiresAt":{"oneOf":[{"$ref":"#/$defs/Time"},{"type":"null"}]},"serverTime":{"$ref":"#/$defs/Time"},"executionEnabled":{"const":false}},"required":["kind","action","measurements","qualified","qualifiedAt","expiresAt","serverTime","executionEnabled"],"unevaluatedProperties":false},
    "PollRequest":{"type":"object","allOf":[{"$ref":"#/$defs/Machine"}],"properties":{"kind":{"const":"probe-services-poll"},"measurements":{"$ref":"#/$defs/Measurements"}},"required":["kind","measurements"],"unevaluatedProperties":false},
    "PollResponse":{"type":"object","allOf":[{"$ref":"#/$defs/Machine"}],"properties":{"kind":{"const":"probe-services-poll-ack"},"measurements":{"$ref":"#/$defs/Measurements"},"observedAt":{"$ref":"#/$defs/Time"},"serverTime":{"$ref":"#/$defs/Time"},"executionEnabled":{"const":false},"offer":{"oneOf":[{"$ref":"#/$defs/Offer"},{"type":"null"}]}},"required":["kind","measurements","observedAt","serverTime","executionEnabled","offer"],"unevaluatedProperties":false},
    "ClaimRequest":{"type":"object","allOf":[{"$ref":"#/$defs/Machine"},{"$ref":"#/$defs/Descriptor"}],"properties":{"kind":{"const":"probe-services-claim"},"permitId":{"$ref":"#/$defs/Id"},"service":{"$ref":"#/$defs/NullableSelection"}},"required":["kind","permitId","service"],"unevaluatedProperties":false},
    "Consumed":{"type":"object","allOf":[{"$ref":"#/$defs/Permit"}],"properties":{"service":{"$ref":"#/$defs/NullableSelection"},"consumedAt":{"$ref":"#/$defs/Time"},"serverTime":{"$ref":"#/$defs/Time"},"state":{"const":"consumed"},"executionEnabled":{"const":false}},"required":["service","consumedAt","serverTime","state","executionEnabled"]},
    "ClaimResponse":{"type":"object","allOf":[{"$ref":"#/$defs/Machine"},{"$ref":"#/$defs/Descriptor"},{"$ref":"#/$defs/Consumed"}],"properties":{"kind":{"const":"probe-services-claim-ack"}},"required":["kind"],"unevaluatedProperties":false},
    "StatusRequest":{"type":"object","allOf":[{"$ref":"#/$defs/Machine"},{"$ref":"#/$defs/Descriptor"}],"properties":{"kind":{"const":"probe-services-status"},"permitId":{"$ref":"#/$defs/Id"},"service":{"$ref":"#/$defs/NullableSelection"}},"required":["kind","permitId","service"],"unevaluatedProperties":false},
    "StatusResponse":{"type":"object","allOf":[{"$ref":"#/$defs/Machine"},{"$ref":"#/$defs/Descriptor"},{"$ref":"#/$defs/Consumed"}],"properties":{"kind":{"const":"probe-services-status-ack"},"checkedAt":{"$ref":"#/$defs/Time"}},"required":["kind","checkedAt"],"unevaluatedProperties":false},
    "TLSResult":{"type":"object","additionalProperties":false,"properties":{"version":{"const":"TLSv1.3"},"alpn":{"const":"tunex-observation/1"},"leafFingerprint":{"$ref":"#/$defs/Hash"},"verified":{"const":true}},"required":["version","alpn","leafFingerprint","verified"]},
    "ResultRequest":{"type":"object","allOf":[{"$ref":"#/$defs/Machine"},{"$ref":"#/$defs/Descriptor"},{"$ref":"#/$defs/Permit"}],"properties":{
      "kind":{"const":"probe-services-result"},"service":{"$ref":"#/$defs/NullableSelection"},"tls":{"oneOf":[{"$ref":"#/$defs/TLSResult"},{"type":"null"}]},
      "consumedAt":{"$ref":"#/$defs/Time"},"measuredAt":{"$ref":"#/$defs/Time"},"validUntil":{"$ref":"#/$defs/Time"},"elapsedMs":{"type":"integer","minimum":0,"maximum":2000},
      "status":{"enum":["connected","unreachable","verified","unverified"]},"code":{"enum":["tcp-connected","tcp-connect-failed","tls-handshake-verified","tls-handshake-failed"]},
      "applicationHealth":{"const":"unknown"},"source":{"const":"agent-reported"},"applicationPayloadBytes":{"const":0}
    },"required":["kind","service","tls","consumedAt","measuredAt","validUntil","elapsedMs","status","code","applicationHealth","source","applicationPayloadBytes"],"unevaluatedProperties":false},
    "ResultResponse":{"type":"object","allOf":[{"$ref":"#/$defs/Machine"},{"$ref":"#/$defs/Descriptor"}],"properties":{
      "kind":{"const":"probe-services-result-ack"},"permitId":{"$ref":"#/$defs/Id"},"service":{"$ref":"#/$defs/NullableSelection"},"resultDigest":{"$ref":"#/$defs/Hash"},"acceptedAt":{"$ref":"#/$defs/Time"},"serverTime":{"$ref":"#/$defs/Time"},"duplicate":{"type":"boolean"},"health":{"const":"unknown"},"executionEnabled":{"const":false}
    },"required":["kind","permitId","service","resultDigest","acceptedAt","serverTime","duplicate","health","executionEnabled"],"unevaluatedProperties":false}
  }
}
