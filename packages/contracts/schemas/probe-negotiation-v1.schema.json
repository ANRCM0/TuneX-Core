{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tunex:probe:negotiation:1",
  "title": "Probe v1 read-only mTLS contract negotiation",
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "instanceId": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$" },
    "counter": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "time": { "type": "string", "format": "date-time", "minLength": 24, "maxLength": 24,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "Request": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "protocolVersion": { "const": 3 },
        "probeVersion": { "const": 1 },
        "kind": { "const": "probe-hello" },
        "nodeId": { "$ref": "#/$defs/id" },
        "bootId": { "$ref": "#/$defs/id" },
        "sessionEpoch": { "$ref": "#/$defs/counter" },
        "instanceId": { "$ref": "#/$defs/instanceId" },
        "capability": { "const": "probe.tcp-connect.v1" },
        "point": { "const": "agent-direct-egress" },
        "maxTimeoutMs": { "const": 2000 },
        "maxAttempts": { "const": 1 },
        "applicationPayloadBytes": { "const": 0 }
      },
      "required": ["protocolVersion", "probeVersion", "kind", "nodeId", "bootId", "sessionEpoch", "instanceId",
        "capability", "point", "maxTimeoutMs", "maxAttempts", "applicationPayloadBytes"]
    },
    "Response": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "protocolVersion": { "const": 3 },
        "probeVersion": { "const": 1 },
        "kind": { "const": "probe-hello-ack" },
        "nodeId": { "$ref": "#/$defs/id" },
        "bootId": { "$ref": "#/$defs/id" },
        "sessionEpoch": { "$ref": "#/$defs/counter" },
        "instanceId": { "$ref": "#/$defs/instanceId" },
        "capability": { "const": "probe.tcp-connect.v1" },
        "point": { "const": "agent-direct-egress" },
        "maxTimeoutMs": { "const": 2000 },
        "maxAttempts": { "const": 1 },
        "applicationPayloadBytes": { "const": 0 },
        "serverTime": { "$ref": "#/$defs/time" },
        "state": { "const": "contract-only" },
        "executionEnabled": { "const": false }
      },
      "required": ["protocolVersion", "probeVersion", "kind", "nodeId", "bootId", "sessionEpoch", "instanceId",
        "capability", "point", "maxTimeoutMs", "maxAttempts", "applicationPayloadBytes", "serverTime", "state", "executionEnabled"]
    }
  }
}
