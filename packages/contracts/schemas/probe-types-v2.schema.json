{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:tunex:probe:types:2",
  "title":"Closed typed Probe v2 machine messages",
  "$defs":{
    "Id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "Hex":{"type":"string","minLength":64,"maxLength":64,"pattern":"^[a-f0-9]{64}$"},
    "Counter":{"type":"integer","minimum":1,"maximum":9007199254740991},
    "Time":{"type":"string","format":"date-time","pattern":"Z$"},
    "Hash":{"type":"string","minLength":71,"maxLength":71,"pattern":"^sha256:[a-f0-9]{64}$"},
    "Machine":{"type":"object","properties":{
      "protocolVersion":{"const":3},"probeVersion":{"const":2},"nodeId":{"$ref":"#/$defs/Id"},"bootId":{"$ref":"#/$defs/Id"},
      "sessionEpoch":{"$ref":"#/$defs/Counter"},"instanceId":{"$ref":"#/$defs/Hex"},"instanceGeneration":{"$ref":"#/$defs/Counter"},"requestId":{"$ref":"#/$defs/Hex"}
    },"required":["protocolVersion","probeVersion","nodeId","bootId","sessionEpoch","instanceId","instanceGeneration","requestId"]},
    "Measurements":{"type":"array","prefixItems":[{"const":"tcp-connect-v1"},{"const":"tcp-ingress-connect-v1"}],"items":false,"minItems":2,"maxItems":2},
    "Descriptor":{"type":"object","properties":{
      "measurement":{"enum":["tcp-connect-v1","tcp-ingress-connect-v1"]},"taskKind":{"enum":["tcp-connect","tcp-ingress-connect"]},
      "point":{"enum":["agent-direct-egress","agent-local-direct-ingress"]},"capability":{"enum":["probe.tcp-connect.v1","probe.tcp-ingress-connect.v1"]}
    },"required":["measurement","taskKind","point","capability"],"oneOf":[
      {"properties":{"measurement":{"const":"tcp-connect-v1"},"taskKind":{"const":"tcp-connect"},"point":{"const":"agent-direct-egress"},"capability":{"const":"probe.tcp-connect.v1"}}},
      {"properties":{"measurement":{"const":"tcp-ingress-connect-v1"},"taskKind":{"const":"tcp-ingress-connect"},"point":{"const":"agent-local-direct-ingress"},"capability":{"const":"probe.tcp-ingress-connect.v1"}}}
    ]},
    "Binding":{"type":"object","additionalProperties":false,"properties":{
      "nodeId":{"$ref":"#/$defs/Id"},"bootId":{"$ref":"#/$defs/Id"},"sessionEpoch":{"$ref":"#/$defs/Counter"},"snapshotGeneration":{"$ref":"#/$defs/Counter"},
      "assignmentId":{"$ref":"#/$defs/Id"},"forwardId":{"$ref":"#/$defs/Id"},"forwardRevision":{"$ref":"#/$defs/Counter"},"deploymentGeneration":{"$ref":"#/$defs/Counter"},
      "bindingFence":{"$ref":"#/$defs/Counter"},"configDigest":{"$ref":"#/$defs/Hash"},"egressPolicyRevision":{"$ref":"#/$defs/Counter"}
    },"required":["nodeId","bootId","sessionEpoch","snapshotGeneration","assignmentId","forwardId","forwardRevision","deploymentGeneration","bindingFence","configDigest","egressPolicyRevision"]},
    "Permit":{"type":"object","properties":{"permitId":{"$ref":"#/$defs/Id"},"binding":{"$ref":"#/$defs/Binding"},"timeoutMs":{"type":"integer","minimum":100,"maximum":2000},"issuedAt":{"$ref":"#/$defs/Time"},"expiresAt":{"$ref":"#/$defs/Time"}},"required":["permitId","binding","timeoutMs","issuedAt","expiresAt"]},
    "Offer":{"type":"object","allOf":[{"$ref":"#/$defs/Descriptor"},{"$ref":"#/$defs/Permit"}],"unevaluatedProperties":false},
    "QualificationRequest":{"type":"object","allOf":[{"$ref":"#/$defs/Machine"}],"properties":{"kind":{"const":"probe-types-instance"},"action":{"enum":["inspect","register","revoke"]},"measurements":{"$ref":"#/$defs/Measurements"}},"required":["kind","action","measurements"],"unevaluatedProperties":false},
    "QualificationResponse":{"type":"object","allOf":[{"$ref":"#/$defs/Machine"}],"properties":{"kind":{"const":"probe-types-instance-ack"},"action":{"enum":["inspect","register","revoke"]},"measurements":{"$ref":"#/$defs/Measurements"},"qualified":{"type":"boolean"},"qualifiedAt":{"oneOf":[{"$ref":"#/$defs/Time"},{"type":"null"}]},"expiresAt":{"oneOf":[{"$ref":"#/$defs/Time"},{"type":"null"}]},"serverTime":{"$ref":"#/$defs/Time"},"executionEnabled":{"const":false}},"required":["kind","action","measurements","qualified","qualifiedAt","expiresAt","serverTime","executionEnabled"],"unevaluatedProperties":false},
    "PollRequest":{"type":"object","allOf":[{"$ref":"#/$defs/Machine"}],"properties":{"kind":{"const":"probe-types-poll"},"measurements":{"$ref":"#/$defs/Measurements"}},"required":["kind","measurements"],"unevaluatedProperties":false},
    "PollResponse":{"type":"object","allOf":[{"$ref":"#/$defs/Machine"}],"properties":{"kind":{"const":"probe-types-poll-ack"},"measurements":{"$ref":"#/$defs/Measurements"},"observedAt":{"$ref":"#/$defs/Time"},"serverTime":{"$ref":"#/$defs/Time"},"executionEnabled":{"const":false},"offer":{"oneOf":[{"$ref":"#/$defs/Offer"},{"type":"null"}]}},"required":["kind","measurements","observedAt","serverTime","executionEnabled","offer"],"unevaluatedProperties":false},
    "ClaimRequest":{"type":"object","allOf":[{"$ref":"#/$defs/Machine"},{"$ref":"#/$defs/Descriptor"}],"properties":{"kind":{"const":"probe-types-claim"},"permitId":{"$ref":"#/$defs/Id"}},"required":["kind","permitId"],"unevaluatedProperties":false},
    "Consumed":{"type":"object","allOf":[{"$ref":"#/$defs/Permit"}],"properties":{"consumedAt":{"$ref":"#/$defs/Time"},"serverTime":{"$ref":"#/$defs/Time"},"state":{"const":"consumed"},"executionEnabled":{"const":false}},"required":["consumedAt","serverTime","state","executionEnabled"]},
    "ClaimResponse":{"type":"object","allOf":[{"$ref":"#/$defs/Machine"},{"$ref":"#/$defs/Descriptor"},{"$ref":"#/$defs/Consumed"}],"properties":{"kind":{"const":"probe-types-claim-ack"}},"required":["kind"],"unevaluatedProperties":false},
    "StatusRequest":{"type":"object","allOf":[{"$ref":"#/$defs/Machine"},{"$ref":"#/$defs/Descriptor"}],"properties":{"kind":{"const":"probe-types-status"},"permitId":{"$ref":"#/$defs/Id"}},"required":["kind","permitId"],"unevaluatedProperties":false},
    "StatusResponse":{"type":"object","allOf":[{"$ref":"#/$defs/Machine"},{"$ref":"#/$defs/Descriptor"},{"$ref":"#/$defs/Consumed"}],"properties":{"kind":{"const":"probe-types-status-ack"},"checkedAt":{"$ref":"#/$defs/Time"}},"required":["kind","checkedAt"],"unevaluatedProperties":false},
    "ResultRequest":{"type":"object","allOf":[{"$ref":"#/$defs/Machine"},{"$ref":"#/$defs/Descriptor"},{"$ref":"#/$defs/Permit"}],"properties":{
      "kind":{"const":"probe-types-result"},"consumedAt":{"$ref":"#/$defs/Time"},"measuredAt":{"$ref":"#/$defs/Time"},"validUntil":{"$ref":"#/$defs/Time"},
      "elapsedMs":{"type":"integer","minimum":0,"maximum":2000},"status":{"enum":["connected","unreachable"]},"code":{"enum":["tcp-connected","tcp-connect-failed"]},
      "applicationHealth":{"const":"unknown"},"source":{"const":"agent-reported"},"applicationPayloadBytes":{"const":0}
    },"required":["kind","consumedAt","measuredAt","validUntil","elapsedMs","status","code","applicationHealth","source","applicationPayloadBytes"],"unevaluatedProperties":false},
    "ResultResponse":{"type":"object","allOf":[{"$ref":"#/$defs/Machine"},{"$ref":"#/$defs/Descriptor"}],"properties":{
      "kind":{"const":"probe-types-result-ack"},"permitId":{"$ref":"#/$defs/Id"},"resultDigest":{"$ref":"#/$defs/Hash"},"acceptedAt":{"$ref":"#/$defs/Time"},"serverTime":{"$ref":"#/$defs/Time"},"duplicate":{"type":"boolean"},"health":{"const":"unknown"},"executionEnabled":{"const":false}
    },"required":["kind","permitId","resultDigest","acceptedAt","serverTime","duplicate","health","executionEnabled"],"unevaluatedProperties":false}
  }
}
