{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tunex:adp:2:direct",
  "title": "ADP/2 direct milestone messages",
  "description": "Normative structural contract only; semantic checks and authentication remain mandatory. Not a Relay schema.",
  "oneOf": [
    {
      "$ref": "#/$defs/HelloRequest"
    },
    {
      "$ref": "#/$defs/HelloResponse"
    },
    {
      "$ref": "#/$defs/Snapshot"
    },
    {
      "$ref": "#/$defs/ReportRequest"
    },
    {
      "$ref": "#/$defs/ReportAck"
    },
    {
      "$ref": "#/$defs/ErrorResponse"
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "counter": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "counterOrZero": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "protocol": {
      "enum": [
        "tcp",
        "udp"
      ]
    },
    "phase": {
      "enum": [
        "prepared",
        "active",
        "draining"
      ]
    },
    "condition": {
      "enum": [
        "pending",
        "prepared",
        "ready",
        "degraded",
        "error",
        "draining",
        "removed"
      ]
    },
    "listen": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "address": {
          "oneOf": [
            {
              "type": "string",
              "format": "ipv4"
            },
            {
              "type": "string",
              "format": "ipv6"
            }
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "required": [
        "address",
        "port"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[A-Za-z0-9.:-]+$"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "required": [
        "host",
        "port"
      ]
    },
    "directConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target": {
          "$ref": "#/$defs/target"
        },
        "egressPolicyRevision": {
          "$ref": "#/$defs/counter"
        },
        "allowMetadataTargets": {
          "type": "boolean"
        },
        "allowedDestinationCidrs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 64
          }
        }
      },
      "required": [
        "target",
        "egressPolicyRevision",
        "allowMetadataTargets",
        "allowedDestinationCidrs"
      ]
    },
    "driver": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "native.direct.v1"
        },
        "schemaVersion": {
          "const": 1
        },
        "configDigest": {
          "$ref": "#/$defs/digest"
        },
        "config": {
          "$ref": "#/$defs/directConfig"
        }
      },
      "required": [
        "id",
        "schemaVersion",
        "configDigest",
        "config"
      ]
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assignmentId": {
          "$ref": "#/$defs/id"
        },
        "forwardId": {
          "$ref": "#/$defs/id"
        },
        "forwardRevision": {
          "$ref": "#/$defs/counter"
        },
        "deploymentGeneration": {
          "$ref": "#/$defs/counter"
        },
        "bindingFence": {
          "$ref": "#/$defs/counter"
        },
        "role": {
          "const": "direct"
        },
        "protocol": {
          "$ref": "#/$defs/protocol"
        },
        "phase": {
          "$ref": "#/$defs/phase"
        },
        "listener": {
          "$ref": "#/$defs/listen"
        },
        "driver": {
          "$ref": "#/$defs/driver"
        },
        "drainTimeoutSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        }
      },
      "required": [
        "assignmentId",
        "forwardId",
        "forwardRevision",
        "deploymentGeneration",
        "bindingFence",
        "role",
        "protocol",
        "phase",
        "listener",
        "driver",
        "drainTimeoutSeconds"
      ]
    },
    "tombstone": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assignmentId": {
          "$ref": "#/$defs/id"
        },
        "forwardId": {
          "$ref": "#/$defs/id"
        },
        "protocol": {
          "$ref": "#/$defs/protocol"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "bindingFence": {
          "$ref": "#/$defs/counter"
        },
        "retirementGeneration": {
          "$ref": "#/$defs/counter"
        }
      },
      "required": [
        "assignmentId",
        "forwardId",
        "protocol",
        "port",
        "bindingFence",
        "retirementGeneration"
      ]
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assignmentId": {
          "$ref": "#/$defs/id"
        },
        "deploymentGeneration": {
          "$ref": "#/$defs/counter"
        },
        "bindingFence": {
          "$ref": "#/$defs/counter"
        },
        "phase": {
          "enum": [
            "prepared",
            "active",
            "draining",
            "absent"
          ]
        },
        "condition": {
          "$ref": "#/$defs/condition"
        },
        "errorCode": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Z][A-Z0-9_]*$"
            }
          ]
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "assignmentId",
        "deploymentGeneration",
        "bindingFence",
        "phase",
        "condition",
        "errorCode",
        "retryable"
      ]
    },
    "drain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assignmentId": {
          "$ref": "#/$defs/id"
        },
        "deploymentGeneration": {
          "$ref": "#/$defs/counter"
        },
        "bindingFence": {
          "$ref": "#/$defs/counter"
        },
        "startedAt": {
          "$ref": "#/$defs/time"
        },
        "deadline": {
          "$ref": "#/$defs/time"
        },
        "remainingConnections": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "condition": {
          "enum": [
            "draining",
            "removed"
          ]
        }
      },
      "required": [
        "assignmentId",
        "deploymentGeneration",
        "bindingFence",
        "startedAt",
        "deadline",
        "remainingConnections",
        "condition"
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pollIntervalSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "leaseSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "renewalLeadSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxClockSkewSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "observationFreshnessSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "drainTimeoutSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        },
        "connectTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "udpIdleTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxTcpConnectionsPerAssignment": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxUdpSessionsPerAssignment": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxSnapshotBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        },
        "maxReportBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "maxAssignmentsPerNode": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      },
      "required": [
        "pollIntervalSeconds",
        "leaseSeconds",
        "renewalLeadSeconds",
        "maxClockSkewSeconds",
        "observationFreshnessSeconds",
        "drainTimeoutSeconds",
        "connectTimeoutSeconds",
        "udpIdleTimeoutSeconds",
        "maxTcpConnectionsPerAssignment",
        "maxUdpSessionsPerAssignment",
        "maxSnapshotBytes",
        "maxReportBytes",
        "maxAssignmentsPerNode"
      ]
    },
    "HelloRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocolVersion": {
          "const": 2
        },
        "nodeId": {
          "$ref": "#/$defs/id"
        },
        "bootId": {
          "$ref": "#/$defs/id"
        },
        "agentBuild": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "lastStoredSnapshotGeneration": {
          "$ref": "#/$defs/counterOrZero"
        }
      },
      "required": [
        "protocolVersion",
        "nodeId",
        "bootId",
        "agentBuild",
        "capabilities",
        "lastStoredSnapshotGeneration"
      ]
    },
    "HelloResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocolVersion": {
          "const": 2
        },
        "nodeId": {
          "$ref": "#/$defs/id"
        },
        "bootId": {
          "$ref": "#/$defs/id"
        },
        "sessionEpoch": {
          "$ref": "#/$defs/counter"
        },
        "serverTime": {
          "$ref": "#/$defs/time"
        },
        "policy": {
          "$ref": "#/$defs/policy"
        }
      },
      "required": [
        "protocolVersion",
        "nodeId",
        "bootId",
        "sessionEpoch",
        "serverTime",
        "policy"
      ]
    },
    "Snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocolVersion": {
          "const": 2
        },
        "nodeId": {
          "$ref": "#/$defs/id"
        },
        "sessionEpoch": {
          "$ref": "#/$defs/counter"
        },
        "snapshotGeneration": {
          "$ref": "#/$defs/counter"
        },
        "complete": {
          "const": true
        },
        "issuedAt": {
          "$ref": "#/$defs/time"
        },
        "validUntil": {
          "$ref": "#/$defs/time"
        },
        "snapshotDigest": {
          "$ref": "#/$defs/digest"
        },
        "assignments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assignment"
          },
          "maxItems": 1000
        },
        "tombstones": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tombstone"
          },
          "maxItems": 100000
        }
      },
      "required": [
        "protocolVersion",
        "nodeId",
        "sessionEpoch",
        "snapshotGeneration",
        "complete",
        "issuedAt",
        "validUntil",
        "snapshotDigest",
        "assignments",
        "tombstones"
      ]
    },
    "ReportRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocolVersion": {
          "const": 2
        },
        "nodeId": {
          "$ref": "#/$defs/id"
        },
        "bootId": {
          "$ref": "#/$defs/id"
        },
        "sessionEpoch": {
          "$ref": "#/$defs/counter"
        },
        "reportSequence": {
          "$ref": "#/$defs/counter"
        },
        "observedAt": {
          "$ref": "#/$defs/time"
        },
        "acceptedSnapshotGeneration": {
          "$ref": "#/$defs/counterOrZero"
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observation"
          },
          "maxItems": 1000
        },
        "drains": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/drain"
          },
          "maxItems": 10000
        }
      },
      "required": [
        "protocolVersion",
        "nodeId",
        "bootId",
        "sessionEpoch",
        "reportSequence",
        "observedAt",
        "acceptedSnapshotGeneration",
        "observations",
        "drains"
      ]
    },
    "ReportAck": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocolVersion": {
          "const": 2
        },
        "nodeId": {
          "$ref": "#/$defs/id"
        },
        "bootId": {
          "$ref": "#/$defs/id"
        },
        "sessionEpoch": {
          "$ref": "#/$defs/counter"
        },
        "reportSequence": {
          "$ref": "#/$defs/counter"
        },
        "status": {
          "enum": [
            "accepted",
            "duplicate"
          ]
        }
      },
      "required": [
        "protocolVersion",
        "nodeId",
        "bootId",
        "sessionEpoch",
        "reportSequence",
        "status"
      ]
    },
    "ErrorResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "retryable": {
          "type": "boolean"
        },
        "retryAfterSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        },
        "requestId": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "code",
        "message",
        "retryable",
        "requestId"
      ]
    }
  }
}
