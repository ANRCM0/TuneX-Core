# syntax=docker/dockerfile:1
ARG TUNEX_SOURCE_REVISION=unknown
# VNext Control executes the checked-in TypeScript entrypoint on Node 24.
# Builds deliberately do not initialize the authority or generate credentials.
FROM node:24-bookworm-slim AS dependencies
WORKDIR /opt/tunex
COPY package.json package-lock.json ./
COPY apps/control/package.json apps/control/package.json
COPY packages/core/package.json packages/core/package.json
COPY packages/contracts/package.json packages/contracts/package.json
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund

FROM node:24-bookworm-slim
ARG TUNEX_SOURCE_REVISION
LABEL org.opencontainers.image.source="https://github.com/ANRCM0/TuneX-Core" \
      org.opencontainers.image.revision="${TUNEX_SOURCE_REVISION}" \
      org.opencontainers.image.title="TuneX VNext Control"
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends ca-certificates openssl && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 10001 tunex && useradd -u 10001 -g 10001 -M -s /usr/sbin/nologin tunex
WORKDIR /opt/tunex
COPY --from=dependencies /opt/tunex/node_modules ./node_modules
COPY package.json package-lock.json ./
COPY apps/control ./apps/control
COPY packages/core ./packages/core
COPY packages/contracts ./packages/contracts
COPY docs/protocol/schemas ./docs/protocol/schemas
COPY apps/web ./apps/web
COPY scripts/ops ./scripts/ops
COPY deploy/control-liveness.mjs ./deploy/control-liveness.mjs
RUN node --input-type=module -e "await import('@tunex/contracts')"
RUN mkdir -p /var/lib/tunex-control && chown 10001:10001 /var/lib/tunex-control
USER 10001:10001
ENV NODE_ENV=production TUNEX_CONTROL_HOST=0.0.0.0 TUNEX_CONTROL_PORT=41001 TUNEX_SOURCE_REVISION=${TUNEX_SOURCE_REVISION}
EXPOSE 41001/tcp
# Local socket liveness only. This is NOT proof of MySQL, mTLS, trust,
# runtime lease issuance or deployment readiness.
HEALTHCHECK --interval=15s --timeout=3s --start-period=30s --retries=3 \
 CMD ["node","deploy/control-liveness.mjs"]
CMD ["node","apps/control/src/main.ts"]
